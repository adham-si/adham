{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "unicorn"],
  "rules": {
    "no-unused-vars": "warn",
    "no-console": ["warn", { "allow": ["warn", "error", "info"] }],
    "eqeqeq": "error",
    "no-var": "error",
    "prefer-const": "error"
  },
  "ignore": [
    "**/node_modules/**",
    "**/dist/**",
    "**/target/**",
    "**/routeTree.gen.ts",
    "**/packages/contracts-generated/**",
    "**/.opencode/**",
    "**/.playwright-mcp/**"
  ]
}
