{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MessageSubmittedV2",
  "type": "object",
  "required": ["message_id", "content_id", "content_kind", "size_bytes", "reference"],
  "properties": {
    "message_id": { "type": "string" },
    "content_id": { "type": "string" },
    "content_kind": { "type": "string", "enum": ["user_text"] },
    "size_bytes": { "type": "integer", "minimum": 1, "maximum": 65536 },
    "reference": {
      "type": ["object", "null"],
      "required": ["refers_to_message_id", "relation"],
      "properties": {
        "refers_to_message_id": { "type": "string" },
        "relation": { "type": "string", "enum": ["replied", "edited-from"] }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
